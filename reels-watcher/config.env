# Reels watcher configuration. Edit paths here only.
# Sourced by every script in this folder.

DRIVE_ROOT="$HOME/Library/CloudStorage/GoogleDrive-veena@vivefunds.com/My Drive"
REELS_DIR="$DRIVE_ROOT/Reels"
RAW_DIR="$REELS_DIR/Raw"
EDITED_DIR="$REELS_DIR/Edited"
DONE_DIR="$REELS_DIR/Done"
SCRIPTS_DIR="$REELS_DIR/Scripts"
INDEX_CSV="$REELS_DIR/INDEX.csv"

# Where raws that get replaced by a newer upload of the same script number go.
SUPERSEDED_DIR="$RAW_DIR/_superseded"

# Local working area (never inside Drive, so half-written files never sync).
WORK_DIR="$HOME/Movies/video-use-jobs"
STATE_DIR="$HOME/reels-watcher/state"
LOG_DIR="$HOME/reels-watcher/logs"

# Downloads ingest (AirDrop from the Edits app lands here).
DOWNLOADS_DIR="$HOME/Downloads"

# Tooling
FFMPEG_BIN="/opt/homebrew/opt/ffmpeg-full/bin"
CLAUDE_BIN="$(command -v claude || echo "$HOME/.local/bin/claude")"
CLAUDE_MODEL="claude-fable-5-1"

# How long one edit may run before the watchdog kills it (seconds).
EDIT_TIMEOUT=5400
# A new file must keep the same size for this long before we treat it as fully synced.
STABLE_SECONDS=45
# Minimum finished-reel length in seconds (hard rule from the manual).
MIN_RUNTIME=65

export PATH="$FFMPEG_BIN:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
