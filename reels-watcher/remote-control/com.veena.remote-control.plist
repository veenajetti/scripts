<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.veena.remote-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/reels-watcher/remote_control.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Restart whenever it exits: network drop, the 10-minute offline give-up, a crash. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>20</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:__HOME__/.local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>TERM</key><string>xterm-256color</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/reels-watcher/logs/remote-control.launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/reels-watcher/logs/remote-control.launchd.log</string>
</dict>
</plist>
